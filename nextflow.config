// EXOME PIPELINE CONFIGURATION FILE

profiles {
  isca {
    // Structural Storage Variables
    params.base               = '/lustre/projects/Research_Project-MRC147594'
    params.software           = "${params.base}/software"
    params.resourcesDir       = "${params.base}/resources/grch38-v2-pipeline"

    // Core Reference Genome Files (hg38)
    params.referenceFasta     = "${params.resourcesDir}/Homo_sapiens_assembly38.fasta"
    params.referenceGFF       = "${params.resourcesDir}/gencode.v47.chr_patch_hapl_scaff.annotation.gff3"
    params.gnomadCommon       = "${params.resourcesDir}/gnomad_v4_1_popmax001.bcf"
    params.gnomadSNP          = "${params.resourcesDir}/gnomad_v4_1_popmax01.bcf"
    params.gnomadSNPFilter    = "${params.resourcesDir}/gnomad_v4_1_common.object"
    params.goldStandardIndels = "${params.resourcesDir}/Mills_and_1000G_gold_standard.indels.hg38.vcf"
    params.dbSnp              = "${params.resourcesDir}/Homo_sapiens_assembly38.dbsnp138.vcf"
    params.vepData            = "${params.resourcesDir}/vep_data/"

    // Supplementary Region Mapping Tracks
    params.easyRegions        = "${params.resourcesDir}/Heng_Li_2025_PMC12409275_GRCh38_easy_regions.bed"
    params.hla_regions        = "${params.resourcesDir}/hla_master_regions.bed"
    params.chr6_fasta         = "${params.resourcesDir}/GRCh38_chr6.fasta"
    params.mantaChromBed      = "${params.resourcesDir}/manta_chrom.bed.gz"
    params.survindel2model    = "${params.resourcesDir}/survindel2_model/ml-model"
    params.xy_bitmap          = "${params.resourcesDir}/current_r04.bitmap"
    params.cytomegaloFasta    = "${params.resourcesDir}/cytomegalovirus/cytomegalovirus.fasta"
    params.xtea_libraries     = "${params.resourcesDir}/xTEA/"
    params.exomeDepthReference= "${params.base}/resources/exome_depth_reference3/"
    params.cnvref = "${params.base}/exome_sequencing/hg38_exome_comp_spikein_v2.0.2.cnn"
    params.mitosaltConfig         = "${params.resourcesDir}/mitosalt/config_human_grch38.txt"
    params.mitosaltEnrichedConfig = "${params.resourcesDir}/mitosalt/config_human_grch38.txt"
    params.genePanelTsv    = "${params.resourcesDir}/gene_panels/monogenic_gene_panel.tsv"
    params.genePanelScript = "${params.resourcesDir}/gene_panels/gene_panel_report.py"

    // Local Tool Platform Binary Hooks
    params.rsync              = "${params.software}/rsync"
    params.javaDir            = "${params.software}/in-house/software/java"
    params.picardJar          = "${params.software}/picard3/picard.jar"
    params.gatkJar            = "${params.software}/gatk4/gatk-4.6.1.0/gatk-package-4.6.1.0-local.jar"
    params.sambamba           = "${params.software}/sambamba/sambamba-1.0.1-linux-amd64-static"
    params.bwaMem1            = "${params.software}/bwa-mem/bwa-0.7.19/bwa"
    params.bwaMem1RefDir      = "${params.resourcesDir}/bwa-mem1"
    params.bwaMem2            = "${params.software}/bwa-mem2/bwa-mem2-2.2.1_x64-linux/bwa-mem2"
    params.rtgtools           = "${params.software}/rtg-tools/rtg-tools-3.12.1/rtg"
    params.expHunterDeNovo    = "${params.software}/expansionhunter-denovo/ExpansionHunterDenovo-v0.9.0-linux_x86_64/bin/ExpansionHunterDenovo"
    params.alamut             = "${params.software}/alamut/alamut-batch-standalone-1.11/alamut-batch"
    params.auxSoftware        = "${params.software}/in-house/software/exome_pipeline"

    // Default Operational Flags
    params.forcefq             = false
    params.rerun_all           = false
    params.skip_parliament     = false
    params.skip_manta          = false
    params.align_only          = false
    params.send_mail           = true

    // Working Temp Space 
    params.tmpDir              = "${params.base}/exome_sequencing/NF_temp"

    // Compute Resources
    params.pbsQueueing        = true
    process.executor          = 'slurm'
    process.queue             = 'mrcq'
    process.time              = '24h'
    executor.account          = 'Research_Project-MRC147594'
    executor.queueSize        = 50
    process.maxRetries        = 5
    process.errorStrategy = { task.attempt <= 3 ? "retry" : "terminate" }

    // Apptainer Container Virtualization Engine Settings
    apptainer {
      enabled      = true
      cacheDir     = "${params.base}/genome_sequencing/Genome_Pipeline_Containers/"
      tmpDir       = params.tmpDir
      pullTimeout  = '240m'
      autoMounts   = true
      runOptions   = "-B /lustre"
      envWhitelist = ['APPTAINER_TMPDIR', 'TMPDIR']
    }

    env {
      APPTAINER_TMPDIR = params.tmpDir
      TMPDIR           = params.tmpDir
    }

    cleanup = true
  }
}

// Directory Permissions Initialisation
process.beforeScript = { 
    def cmd = """
        umask 0002
       """.stripIndent().trim()
    return cmd
}

// Debug Log 
process.afterScript = {
    def logMainDir = params.batchDir+"/r04_logs" 
    logMainDir = workflow.launchDir.resolve(logMainDir).toString()

    def safeProc = task.process
                    .replaceAll(/\s+/, '_')
                    .replaceAll(/[()]/, '')
    def logDir = "${logMainDir}/${safeProc}"                       

    def tagPrefix = task.tag ? "${task.tag}_" : ''

    def cmd = """
        ls -alR --full-time > .command.ls

        mkdir -p nxf_log
        for f in .command.* ; do
            chmod 664 "\${f}"
            cp -a "\${f}" "nxf_log/${tagPrefix}\${f#.}.txt"
        done

        chmod 664 nxf_log/*

        mkdir -p "${logDir}"
        chmod 2775 "${logDir}"
        cp -a nxf_log/* "${logDir}/"
    """.stripIndent().trim()
    return cmd
}
